@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@* @model IEnumerable<ITTalents.Models.TDanhMucSp> *@
@using ITTalents.Models
@using X.PagedList.Mvc.Core;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model X.PagedList.IPagedList<TDanhMucSp>

<h2>Danh mục các sản phẩm</h2>
<button>
    <a asp-controller="HomeAdmin" asp-action="ThemSanPhamMoi">Thêm mới</a>
</button>
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Striped Table</h4>
            <p class="card-description">
                Add class <code>.table-striped</code>
            </p>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model[0].TenSp)</th>
                        <th>@Html.DisplayNameFor(model => model[0].CanNang)</th>
                        <th>@Html.DisplayNameFor(model => model[0].ThoiGianBaoHanh)</th>
                        <th>@Html.DisplayNameFor(model => model[0].GiaLonNhat)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 0;
                        string @cls = "table-sucess";
                    }
                    @foreach (var item in Model)
                    {
                        i = i + 1;
                        cls = "table-sucess";
                        if(i%2 == 0)
                        {
                            cls = "table-primary";
                        }
                        <tr class="@cls">
                            <td>@Html.DisplayFor(modelItem => item.TenSp)</td>
                            <td>@Html.DisplayFor(modelItem => item.CanNang)</td>
                            <td>@Html.DisplayFor(modelItem => item.ThoiGianBaoHanh)</td>
                            <td>@Html.DisplayFor(modelItem => item.GiaLonNhat)</td>
                            <td>
                                <a asp-controller="HomeAdmin" asp-action="SuaSanPham" asp-route-maSp="@item.MaSp">Edit</a>
                                <a asp-controller="HomeAdmin" asp-action="SuaSanPham" asp-route-maSp="@item.MaSp">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="product__pagination">
                @Html.PagedListPager(Model, page => Url.Action("DanhMucSanPham", new {page = page}))
                @* @Html.PagedListPager(Model, page => Url.Action("DanhMucSanPham", new {page = page}),
                                        new X.PagedList.Web.Common.PagedListRenderOptions()
                                        {
                                            LiElementClasses = new List<String> {"page-item"},
                                            PageClasses = new List<String> { "page-link" }
                                        }
                ) *@
            </div>

        </div>
    </div>
</div>

