@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutOgani.cshtml";
}
@model X.PagedList.IPagedList<TDanhMucSp>
@using X.PagedList.Mvc.Core;


<h5>Trang index Hùng đã thay đổi</h5>

<section class="featured spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Featured Product</h2>
                </div>
                <div class="featured__controls">
                    <ul>
                        <li class="active" data-filter="*">All</li>
                        <li data-filter=".oranges">Oranges</li>
                        <li data-filter=".fresh-meat">Fresh Meat</li>
                        <li data-filter=".vegetables">Vegetables</li>
                        <li data-filter=".fastfood">Fastfood</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="row featured__filter" id="displayProducts">
            @foreach (var item in Model)
            {
                @* <div class="col-lg-3 col-md-4 col-sm-6 mix oranges fresh-meat">
                    <div class="featured__item">
                        <div class="featured__item__pic set-bg" data-setbg="@Url.Content("../1LayoutOgani/img/ImageProducts/" + item.AnhDaiDien)">
                            <ul class="featured__item__pic__hover">
                                <li><a href="#"><i class="fa fa-heart"></i></a></li>
                                <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                                <li><a href="#"><i class="fa fa-shopping-cart"></i></a></li>
                            </ul>
                        </div>
                        <div class="featured__item__text">
                            <h6><a asp-controller="Home" asp-action="ChiTietSanPham" asp-route-maSP="@item.MaSp">@item.TenSp</a></h6>
                            <h5>$@item.GiaNhoNhat</h5>
                        </div>
                    </div>
                </div> *@
                @await Html.PartialAsync("PartialSanPham", item)
            }
        </div>
        <div class="product__pagination">
            @Html.PagedListPager(Model, page => Url.Action("Index", new {page = page}))
        </div>
    </div>
</section>
